@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Details";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h1>@Html.DisplayFor(model => model.Title)</h1>
<hr />

<div>
    <dl class="row">
        <div class="col-md-3">
            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid" />
        </div>
        <div class="col-md-7">
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Synopsis)
            </dt>
            <dd class = "col-sm-10 fs-6">
                @Html.DisplayFor(model => model.Synopsis)
            </dd>
            <hr />
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.GenreId)
            </dt>
            <dd class = "col-sm-10 fs-5">
                @Html.DisplayFor(model => model.Genre.Title)
            </dd>
            <hr /> 
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.AudienceRatingId)
            </dt>
            <dd class = "col-sm-10 fs-5">
                @Html.DisplayFor(model => model.AudienceRating.Title)
            </dd>
            <hr />
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Runtime)
            </dt>
            <dd class = "col-sm-10 fs-5">
                @Html.DisplayFor(model => model.RuntimeHours)
            </dd>
            <hr />
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </dt>
            <dd class = "col-sm-10 fs-5">
                @Html.DisplayFor(model => model.ReleaseDate)
            </dd>
            <hr />
            <div class="row">
                <dt class="col-sm-3">
                    Published Reviews
                </dt>
                <dd class="col-sm-9 fs-5">
                    @Model.CriticReview.Count
                </dd>
            </div>
            <hr />
            @if (User.IsInRole("admin"))
            {
                <div class="mb-3">
                    <a asp-action="Edit" class="btn btn-secondary btn-sm" role="button" asp-route-id="@Model?.Id">Edit</a> | 
                    <a asp-action="Index">Back to Browse</a>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <a asp-controller="CriticReviews" asp-action="Create" asp-route-movieId="@Model.Id" class="btn btn-primary btn-sm">Add Review</a>
                </div>
                <div class="mb-3">
                    <a asp-action="Index">Back to Browse</a>
                </div>
            }
        </div>
        <div class="col-md-2">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.DirectorId)
            </dt>
            <dd class="col-sm-10 fs-5">
                @Html.DisplayFor(model => model.Director.Name)
            </dd>
            <img src="@Model.Director.ImageUrl" alt="@Model.Director.Name" class="img-fluid" />
        </div>
    </dl>
</div>


