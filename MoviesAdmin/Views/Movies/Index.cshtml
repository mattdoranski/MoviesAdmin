@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>List of Films</h1>

@if (User.IsInRole("admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary" role="button">Add New Film</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @* Movie poster section *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Director)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GenreId)
            </th> 
            <th>
                @Html.DisplayNameFor(model => model.AudienceRatingId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.OrderByDescending(item => item.ReleaseDate)) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail" />
            </td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Director)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.AudienceRating.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.RuntimeHours)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            @if (User.IsInRole("admin"))
            {
                <td>
                    <a asp-action="Details" class="btn btn-info btn-sm" role="button" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" class="btn btn-secondary btn-sm" role="button" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" class="btn btn-warning btn-sm" role="button" asp-route-id="@item.Id">Delete</a>
                </td>
            }
            else
            {
                <td>
                    <a asp-action="Details" class="btn btn-info btn-sm" role="button" asp-route-id="@item.Id">Details</a>
                </td>
            }
        </tr>
}
    </tbody>
</table>
