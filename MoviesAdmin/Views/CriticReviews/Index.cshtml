@model IEnumerable<MoviesAdmin.Models.CriticReview>

@{
    ViewData["Title"] = "Critic Reviews";
}

<h1>My Reviews</h1>

@* <p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p> *@
<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>@Html.DisplayNameFor(model => model.Movie)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.Rating)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderByDescending(item => item.CreatedDate))
        {
            <tr>
                <td>
                    <img src="@item.Movie.ImageUrl" alt="@item.Movie.Title" class="thumbnail" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Movie.Title)</td>
                <td style="max-width: 400px">@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.Rating)</td>
                <td>@Html.DisplayFor(modelItem => item.CreatedDate)</td>
                
                @if (item.IsPublished)
                {
                    <td>
                        <a asp-action="Details" class="btn btn-info btn-sm" role="button" asp-route-id="@item.Id">Published</a>
                    </td>
                }
                else
                {
                    <td>
                        <a asp-action="Edit" class="btn btn-secondary btn-sm" role="button" asp-route-id="@item.Id">Edit Draft</a> |
                        <a asp-action="Delete" class="btn btn-warning btn-sm" role="button" asp-route-id="@item.Id">Delete</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
