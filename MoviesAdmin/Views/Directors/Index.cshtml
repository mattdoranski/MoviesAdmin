@model IEnumerable<MoviesAdmin.Models.Director>

@{
    ViewData["Title"] = "Directors";
}

<h1>Directors</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ImageUrl)</th>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@item.ImageUrl" alt="@item.Name" class="thumbnail" />
                </td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>
                    <a asp-action="Details" class="btn btn-info btn-sm" role="button" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Edit" class="btn btn-secondary btn-sm" role="button" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Delete" class="btn btn-warning btn-sm" role="button" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
